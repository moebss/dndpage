# DnD Story Forge - API Keys Template
# Kopiere diese Datei zu .env und füge deine Keys ein

# Perplexity API Key für Text-Generierung
# Hol dir einen Key bei: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Gemini API Key für Bildgenerierung
# Hol dir einen Key bei: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Server Port (optional)
PORT=4000
