# DnD Story Forge - API Keys Template
# Kopiere diese Datei zu .env und füge deine Keys ein

# Perplexity API Key für Text-Generierung
# Hol dir einen Key bei: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# Gemini API Key für Bildgenerierung
# Hol dir einen Key bei: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Google OAuth Credentials
# Hol dir Credentials bei: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Session Secret (generiere einen zufälligen String)
SESSION_SECRET=your-random-secret-string-here

# Frontend URL (für CORS und OAuth Redirect)
FRONTEND_URL=http://localhost:5500

# Supabase Credentials
# Hol dir die Credentials bei: https://supabase.com/
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Server Port (optional)
PORT=4000
