{
    "rewrites": [
        {
            "source": "/auth/(.*)",
            "destination": "http://localhost:4000/auth/$1"
        },
        {
            "source": "/api/characters(.*)",
            "destination": "http://localhost:4000/api/characters$1"
        },
        {
            "source": "/api/stories(.*)",
            "destination": "http://localhost:4000/api/stories$1"
        },
        {
            "source": "/api/perplexity",
            "destination": "/api/perplexity.js"
        },
        {
            "source": "/api/gemini",
            "destination": "/api/gemini.js"
        }
    ]
}